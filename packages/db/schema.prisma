generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


//////////////////////
// ENUMS
//////////////////////

enum UserRole {
  STUDENT
  COMPANY
  ADMIN
}

enum StudentFileType {
  CV
  MOTIVATION_LETTER
  PROFILE_PICTURE
}

enum EventImageType {
  LOGO
  BANNER
  GALLERY
}

enum InternshipStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum WorkMode {
  ON_SITE
  REMOTE
  HYBRID
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

//////////////////////
// USERS (BASE)
//////////////////////

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email                String    @unique
  passwordHash         String?
  role                 UserRole
  passwordResetToken   String?
  passwordResetExpires DateTime?
  createdAt            DateTime  @default(now())

  student  Student?
  company  Company?
  admin    Admin?
}

//////////////////////
// STUDENTS
//////////////////////

model Student {
  userId        String   @id @db.Uuid
  firstName     String?
  lastName      String?
  universityId  String?
  fieldOfStudy  String?
  cvUrl         String?

  user          User     @relation(fields: [userId], references: [id])
  files         StudentFile[]
  applications  Application[]
}

model StudentFile {
  id        String          @id @default(uuid()) @db.Uuid
  studentId String          @db.Uuid
  fileUrl   String
  fileType  StudentFileType
  createdAt DateTime        @default(now())

  student   Student @relation(fields: [studentId], references: [userId])
}

//////////////////////
// COMPANIES
//////////////////////

model Company {
  userId      String  @id @db.Uuid
  name        String
  description String?
  website     String?
  logoUrl     String?

  user        User        @relation(fields: [userId], references: [id])
  internships Internship[]
}

//////////////////////
// ADMINS
//////////////////////

model Admin {
  userId   String @id @db.Uuid
  fullName String

  user     User   @relation(fields: [userId], references: [id])
}

//////////////////////
// EVENTS
//////////////////////

model Event {
  id            String       @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  slogan        String?
  year          Int
  invitationPdf String?
  formUrl       String?
  startDate     DateTime
  endDate       DateTime
  location      String?
  isActive      Boolean      @default(false)
  createdAt     DateTime     @default(now())

  images        EventImage[]
  internships   Internship[]
}

model EventImage {
  id        String         @id @default(uuid()) @db.Uuid
  eventId   String         @db.Uuid
  imageUrl  String
  imageType EventImageType
  createdAt DateTime       @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
}

//////////////////////
// INTERNSHIPS
//////////////////////

model Internship {
  id          String            @id @default(uuid()) @db.Uuid
  companyId   String            @db.Uuid
  eventId     String            @db.Uuid
  title       String
  status      InternshipStatus  @default(PENDING)
  description String?
  field       String?
  duration    String?
  workMode    WorkMode
  location    String?
  createdAt   DateTime         @default(now())

  company     Company          @relation(fields: [companyId], references: [userId])
  event       Event            @relation(fields: [eventId], references: [id])
  applications Application[]
}

//////////////////////
// APPLICATIONS
//////////////////////

model Application {
  id                        String             @id @default(uuid()) @db.Uuid
  internshipId              String             @db.Uuid
  applicantId               String             @db.Uuid
  applicantCv               String?
  applicantMotivationLetter String?
  status                    ApplicationStatus  @default(PENDING)
  appliedAt                 DateTime           @default(now())
  reviewedAt                DateTime?

  internship Internship @relation(fields: [internshipId], references: [id])
  applicant  Student    @relation(fields: [applicantId], references: [userId])
}